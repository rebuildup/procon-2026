# procon-2026 — example environment variables.
# Copy to .env (gitignored) and fill in real values for local dev.

# Rust / tracing
RUST_LOG=info,engine=debug
RUST_BACKTRACE=1

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:7878
VITE_WS_URL=ws://127.0.0.1:7878/ws
VITE_LOG_LEVEL=info

# Engine server (placeholder; not started yet)
PROCON_ENGINE_PORT=7878
PROCON_ENGINE_HOST=127.0.0.1

# Coordinator (Issue #51 — see docs/ops/container.md)
# `procon coordinator` reads these at startup. Defaults shown.
# PROCON_SERVER=localhost:7878
# PROCON_AGENT_URL=http://localhost:7878/agent
# PROCON_SETTING_URL=http://localhost:7878/setting
# PROCON_TOKEN=
# PROCON_HTTP_TIMEOUT_MS=5000
# PROCON_HTTP_RETRIES=3
# PROCON_HTTP_BACKOFF_MS=250