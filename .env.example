# procon-2026 — example environment variables.
# Copy to .env (gitignored) and fill in real values for local dev.

# Rust / tracing
RUST_LOG=info,engine=debug
RUST_BACKTRACE=1

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:7878
VITE_WS_URL=ws://127.0.0.1:7878/ws
VITE_LOG_LEVEL=info

# Engine server (placeholder; not started yet)
PROCON_ENGINE_PORT=7878
PROCON_ENGINE_HOST=127.0.0.1