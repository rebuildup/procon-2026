{
  "name": "@procon-2026/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SolidJS + WebGPU viewer/UI for the procon-2026 contest.",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/typescript-native/bin/tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "check": "node node_modules/typescript-native/bin/tsc --noEmit && node node_modules/typescript-native/bin/tsc --noEmit -p e2e",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test --conditions=browser src",
    "record": "playwright test",
    "record:install": "playwright install chromium",
    "record:match": "bun scripts/record-match.mjs",
    "record:live": "bun scripts/record-live.mjs"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "@primer/css": "^22.3.2",
    "@primer/octicons": "^19.38.0",
    "@primer/primitives": "^11.10.0",
    "@solidjs/router": "^1.0.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@happy-dom/global-registrator": "^20.14.5",
    "@playwright/test": "1.63.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@webgpu/types": "^0.1.60",
    "eslint": "^10.11.0",
    "eslint-plugin-solid": "^0.18.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.0",
    "typescript-native": "npm:typescript@^7.0.2"
  }
}
